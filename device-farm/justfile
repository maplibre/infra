set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

stack := source_directory() / "../opentofu/device-farm"

# List Device Farm orchestrator build and deployment commands.
default:
    @just --list

# Format the Go source files.
fmt:
    gofmt -w .

# Run gofmt check, go vet, race-enabled tests, and OpenTofu validation without changing infrastructure.
check:
    test -z "$(gofmt -l .)"
    go vet ./...
    go test -race ./...
    tofu -chdir="{{stack}}" validate

# Build the static linux/arm64 Lambda bootstrap binary and zip package.
build:
    mkdir -p build
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o build/bootstrap ./cmd/device-farm
    rm -f build/bootstrap.zip
    zip -j -q build/bootstrap.zip build/bootstrap

# Create local tfvars from the example.
configure:
    @if [[ ! -e "{{stack}}/terraform.tfvars" ]]; then cp "{{stack}}/terraform.tfvars.example" "{{stack}}/terraform.tfvars"; fi
    @echo 'Edit {{stack}}/terraform.tfvars if you want to restrict allowed_branches.'

# Connect to the Device Farm state in S3.
init:
    tofu -chdir="{{stack}}" init

# Build the Lambda zip and save an OpenTofu plan; this does not deploy anything.
plan: build
    tofu -chdir="{{stack}}" plan -out=deploy.tfplan

# Apply the previously saved plan.
apply:
    tofu -chdir="{{stack}}" apply deploy.tfplan

# Print the deployment outputs.
outputs:
    tofu -chdir="{{stack}}" output

# Print the GitHub App webhook URL.
webhook-url:
    @tofu -chdir="{{stack}}" output -raw webhook_url

# Remove this stack; keep the shared state bucket and AWS Device Farm project.
destroy:
    tofu -chdir="{{stack}}" destroy
