{
  "name": "maplibre-device-farm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --minify --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=build/index.mjs && rm -f build/lambda.zip && zip -j -q build/lambda.zip build/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "fmt": "prettier --write src test package.json tsconfig.json",
    "fmt:check": "prettier --check src test package.json tsconfig.json",
    "check": "npm run fmt:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-device-farm": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@octokit/webhooks-methods": "^5.1.0",
    "fast-xml-parser": "^5.0.0",
    "octokit": "^5.0.5",
    "smol-toml": "^1.9.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "yazl": "^3.3.1"
  }
}
